{
  "name": "keno-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:reset": "docker exec -i keno-postgres psql -U keno -d keno -v ON_ERROR_STOP=1 < db/schema.sql && docker exec -i keno-postgres psql -U keno -d keno -v ON_ERROR_STOP=1 < db/seed.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0"
  }
}
